.status-invalid { background: rgba(255, 68, 68, 0.15); color: var(--invalid-red); }
.status-pending { background: rgba(255, 171, 0, 0.15); color: var(--pending-yellow); }
.result-data { font-family: var(--font-mono); font-size: 0.85rem; color: var(--text-secondary); word-break: break-all; background: var(--bg-primary); padding: 0.6rem; border-radius: var(--radius-sm); margin-top: 0.5rem; max-height: 80px; overflow-y: auto; }
