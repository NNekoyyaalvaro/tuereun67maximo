@keyframes blink { 50% { opacity: 0.4; } }

.results-actions { display: flex; gap: 0.5rem; flex-wrap: wrap; }
.results-stats { display: flex; gap: 1rem; margin-bottom: 1.5rem; flex-wrap: wrap; }
.result-stat { background: var(--bg-card); padding: 0.8rem 1.2rem; border-radius: var(--radius-md); flex: 1; min-width: 120px; text-align: center; }
.result-stat-label { display: block; font-size: 0.75rem; color: var(--text-muted); margin-bottom: 0.3rem; text-transform: uppercase; }
.result-stat-value { font-size: 1.5rem; font-weight: 700; font-family: var(--font-mono); }

.results-container { max-height: 500px; overflow-y: auto; padding-right: 0.5rem; }
