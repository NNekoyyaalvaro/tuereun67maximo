.service-progress { display: flex; flex-wrap: wrap; gap: 0.5rem; }
.service-progress-item { background: var(--bg-card); padding: 0.3rem 0.6rem; border-radius: var(--radius-sm); font-size: 0.8rem; display: flex; align-items: center; gap: 0.4rem; }
.progress-dot { width: 8px; height: 8px; border-radius: 50%; }
.progress-dot.active { background: var(--accent-red); animation: blink 1s infinite; }
