.btn-icon-small { background: var(--bg-secondary); border: 1px solid var(--border-color); color: var(--text-secondary); padding: 0.3rem 0.6rem; border-radius: var(--radius-sm); cursor: pointer; font-size: 0.8rem; transition: all 0.2s; }
.btn-icon-small:hover { color: var(--accent-red); border-color: var(--accent-red); }

