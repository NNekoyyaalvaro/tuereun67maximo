.btn-download-pack:hover { background: rgba(255, 45, 45, 0.1); }

.btn-clear { background: transparent; color: var(--text-muted); border: 1px solid var(--border-color); }
.btn-clear:hover { color: var(--invalid-red); border-color: var(--invalid-red); }

